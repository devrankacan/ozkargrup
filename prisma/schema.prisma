generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Car {
  id           String        @id @default(cuid())
  name         String
  brand        String
  category     String
  pricePerDay  Float
  transmission String
  fuelType     String
  seats        Int
  imageUrl     String?
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  reservations Reservation[]
  images       CarImage[]
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Reservation {
  id           String   @id @default(cuid())
  carId        String
  car          Car      @relation(fields: [carId], references: [id])
  fullName     String
  email        String
  phone        String
  startDate    DateTime
  endDate      DateTime
  pickupPlace  String
  dropoffPlace String
  notes        String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String
  discount    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SiteSettings {
  id                  String  @id @default("main")
  logoUrl             String?
  heroImageDesktopUrl String?
  heroImageMobileUrl  String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}
